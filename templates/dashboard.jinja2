<!doctype html>
<html lang="en">
<head>

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

<!-- Optional: your own CSS -->
<link rel="stylesheet" href="{{ url_for('static', filename='css/dashboard.css') }}">

</head>

<body>

<nav class="navbar bg-white border-bottom">
  <div class="container">

    <span class="navbar-brand fw-bold">
      <i class="fa-solid fa-chart-line me-2"></i>
      Mini Dashboard
    </span>

    <div>
      <button class="btn btn-outline-secondary" id="btnRandomize">
        <i class="fa-solid fa-shuffle"></i>
        Randomize
      </button>

      <button class="btn btn-dark" id="btnExport">
        <i class="fa-solid fa-download"></i>
        Export
      </button>
    </div>

  </div>
</nav>

<div class="container mt-4">

  <div class="row">

    <div class="col-lg-8">
      <div class="card p-4">
        <h5>Trend</h5>
        <canvas id="trendChart"></canvas>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card p-4">
        <h5>KPI</h5>
        <p>Total: <b id="kpiTotal">{{ kpi_total }}</b></p>
        <p>Average: <b id="kpiAvg">{{ kpi_avg }}</b></p>
        <p>Max: <b id="kpiMax">{{ kpi_max }}</b></p>
      </div>
    </div>

  </div>

  <div class="card p-4 mt-4">
    <h5>Records</h5>

    <table class="table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Metric</th>
          <th>Status</th>
          <th>Notes</th>
        </tr>
      </thead>

      <tbody>
        {% for r in rows %}
        <tr>
          <td>{{ r.date }}</td>
          <td>{{ r.value }}</td>
          <td>
            {% if r.status == "OK" %}
            <span class="badge text-bg-success">OK</span>
            {% else %}
            <span class="badge text-bg-warning">High</span>
            {% endif %}
          </td>
          <td>{{ r.note }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

</div>

<!-- Libraries -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Inject server data (Jinja is allowed here because this is a template) -->
<script>
  window.dashboardData = {
    labels: {{ labels | tojson }},
    values: {{ values | tojson }}
  };
</script>

<!-- Your separated JS -->
<script src="{{ url_for('static', filename='js/dashboard.js') }}"></script>

</body>
</html>