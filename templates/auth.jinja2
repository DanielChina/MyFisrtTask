<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login / Register</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: #f8f9fa;
    }

    .auth-card {
      max-width: 460px;
      margin: 60px auto;
    }

    .tab-pane-custom {
      display: none;
    }

    .tab-pane-custom.active {
      display: block;
    }
  </style>
</head>
<body>

<div class="container">
  <div class="card shadow-sm auth-card">
    <div class="card-body p-4">
      <h2 class="text-center mb-4">Account Access</h2>

      {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
          {% for category, message in messages %}
            <div class="alert alert-{{ category }}" role="alert">
              {{ message }}
            </div>
          {% endfor %}
        {% endif %}
      {% endwith %}

      <ul class="nav nav-tabs mb-4" id="authTabs">
        <li class="nav-item">
          <button
            type="button"
            class="nav-link {% if active_tab == 'login' %}active{% endif %}"
            id="showLogin"
          >
            Login
          </button>
        </li>
        <li class="nav-item">
          <button
            type="button"
            class="nav-link {% if active_tab == 'register' %}active{% endif %}"
            id="showRegister"
          >
            Register
          </button>
        </li>
      </ul>

      <div id="loginPanel" class="tab-pane-custom {% if active_tab == 'login' %}active{% endif %}">
        <form method="post">
          <input type="hidden" name="action" value="login">

          <div class="mb-3">
            <label for="login_username" class="form-label">Username</label>
            <input type="text" class="form-control" id="login_username" name="login_username" required>
          </div>

          <div class="mb-3">
            <label for="login_password" class="form-label">Password</label>
            <input type="password" class="form-control" id="login_password" name="login_password" required>
          </div>

          <button type="submit" class="btn btn-dark w-100">Login</button>
        </form>
      </div>

      <div id="registerPanel" class="tab-pane-custom {% if active_tab == 'register' %}active{% endif %}">
        <form method="post">
          <input type="hidden" name="action" value="register">

          <div class="mb-3">
            <label for="register_username" class="form-label">Username</label>
            <input type="text" class="form-control" id="register_username" name="register_username" required>
          </div>

          <div class="mb-3">
            <label for="register_password" class="form-label">Password</label>
            <input type="password" class="form-control" id="register_password" name="register_password" required>
          </div>

          <div class="mb-3">
            <label for="confirm_password" class="form-label">Confirm Password</label>
            <input type="password" class="form-control" id="confirm_password" name="confirm_password" required>
          </div>

          <button type="submit" class="btn btn-primary w-100">Register</button>
        </form>
      </div>

    </div>
  </div>
</div>

<script>
  const showLogin = document.getElementById("showLogin");
  const showRegister = document.getElementById("showRegister");
  const loginPanel = document.getElementById("loginPanel");
  const registerPanel = document.getElementById("registerPanel");

  function activateTab(tabName) {
    if (tabName === "login") {
      showLogin.classList.add("active");
      showRegister.classList.remove("active");
      loginPanel.classList.add("active");
      registerPanel.classList.remove("active");
    } else {
      showRegister.classList.add("active");
      showLogin.classList.remove("active");
      registerPanel.classList.add("active");
      loginPanel.classList.remove("active");
    }
  }

  showLogin.addEventListener("click", function () {
    activateTab("login");
  });

  showRegister.addEventListener("click", function () {
    activateTab("register");
  });
</script>

</body>
</html>